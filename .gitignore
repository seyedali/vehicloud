# Vehicloud .gitignore
# Add patterns for files you don't want to commit

# Dependencies
node_modules/
bower_components/
vendor/
packages/

# Build outputs
dist/
build/
out/
target/
bin/
obj/
*.o
*.a
*.so
*.exe
*.dll

# Environment and configuration
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
config.local.*
secrets.yml

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Testing
coverage/
*.cover
.coverage
.pytest_cache/
.jest/
test-results/

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.cache
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
venv/
env/
ENV/

# Java
*.class
*.jar
*.war
*.ear
.gradle/
gradle/

# JavaScript/Node
package-lock.json
yarn.lock
.npm/
.eslintcache

# Ruby
*.gem
.bundle/
Gemfile.lock

# Go
go.sum
*.test

# Rust
Cargo.lock
/target/

# Database
*.sqlite
*.sqlite3
*.db

# Compiled files
*.com
*.exe
*.out
*.app
